# Database & Server
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/edupye
PORT=5000

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here
EDUPYE_SSO_SECRET=your_cross_module_sso_secret_minimum_32_characters_here

# Cross-Origin Frame & Iframe Permissions (Space-separated URLs)
ALLOWED_IFRAME_ORIGINS=http://localhost:3001 http://localhost:3002 http://localhost:5173

# Cross-Origin Resource Sharing (CORS) - Comma or space separated allowed frontend origins (or * for all)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://edupye.com,https://app.edupye.com

# Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here

# Academic Search Provider Configuration
ACADEMIC_SEARCH_PROVIDER=crossref
CROSSREF_MAILTO=research@edupye.com
SEMANTIC_SCHOLAR_API_KEY=
