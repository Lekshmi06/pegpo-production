# Database & Server
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/edupye
PORT=5000

# Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here

# Academic Search Provider Configuration (Strictly Server-Side)
# Options: "crossref" (default, free, no key needed) | "semanticscholar"
ACADEMIC_SEARCH_PROVIDER=crossref

# Crossref Polite Pool Contact Email (Provides 10 req/s dedicated pool)
CROSSREF_MAILTO=research@edupye.com

# Optional Semantic Scholar API Key (Kept server-side, never exposed to frontend)
SEMANTIC_SCHOLAR_API_KEY=
